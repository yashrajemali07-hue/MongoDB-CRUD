              "body": "{\n  \"success\": true,\n  \"message\": \"Student deleted successfully\",\n  \"student\": {\n    \"_id\": \"65f1a2b3c4d5e6f7a8b9c0d1\",\n    \"studentName\": \"Aarav Sharma\",\n    \"email\": \"aarav.sharma@college.edu\",\n    \"rollNumber\": \"CS2026101\",\n    \"branch\": \"Information Technology\",\n    \"year\": 4\n  }\n}"
