              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Student updated successfully\",\n  \"student\": {\n    \"_id\": \"65f1a2b3c4d5e6f7a8b9c0d1\",\n    \"studentName\": \"Aarav Sharma\",\n    \"email\": \"aarav.sharma@college.edu\",\n    \"rollNumber\": \"CS2026101\",\n    \"branch\": \"Information Technology\",\n    \"year\": 4,\n    \"createdAt\": \"2026-11-12T18:00:00.000Z\",\n    \"updatedAt\": \"2026-11-12T18:15:00.000Z\",\n    \"__v\": 0\n  }\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const resData = pm.response.json();",
                  "pm.test('Student fields updated properly', function () {",
                  "    pm.expect(resData.success).to.be.true;",
                  "    pm.expect(resData.student.year).to.eql(4);",
                  "    pm.expect(resData.student.branch).to.eql('Information Technology');",
                  "});"
                ]
              }
            }
          ]
        },
