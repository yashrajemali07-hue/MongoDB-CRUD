  "item": [
    {
      "name": "CRUD Operations",
      "description": "Core CRUD endpoints for managing student records.",
      "item": [
        {
          "name": "1. Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentName\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@college.edu\",\n  \"rollNumber\": \"CS2026101\",\n  \"branch\": \"Computer Science\",\n  \"year\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Creates a new student record and automatically stores the returned _id in the studentId collection variable."
          },
          "response": [
            {
              "name": "201 Created Example",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Student created successfully\",\n  \"student\": {\n    \"_id\": \"65f1a2b3c4d5e6f7a8b9c0d1\",\n    \"studentName\": \"Aarav Sharma\",\n    \"email\": \"aarav.sharma@college.edu\",\n    \"rollNumber\": \"CS2026101\",\n    \"branch\": \"Computer Science\",\n    \"year\": 3,\n    \"createdAt\": \"2026-11-12T18:00:00.000Z\",\n    \"updatedAt\": \"2026-11-12T18:00:00.000Z\",\n    \"__v\": 0\n  }\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const resData = pm.response.json();",
                  "pm.test('Response contains student object', function () {",
                  "    pm.expect(resData.success).to.be.true;",
                  "    pm.expect(resData.student).to.be.an('object');",
                  "    pm.expect(resData.student._id).to.be.a('string');",
                  "});",
                  "if (resData.student && resData.student._id) {",
                  "    pm.collectionVariables.set('studentId', resData.student._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get All Students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Retrieves all students sorted by creation date (newest first)."
          },
          "response": [
            {
              "name": "200 OK Example",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"count\": 1,\n  \"students\": [\n    {\n      \"_id\": \"65f1a2b3c4d5e6f7a8b9c0d1\",\n      \"studentName\": \"Aarav Sharma\",\n      \"email\": \"aarav.sharma@college.edu\",\n      \"rollNumber\": \"CS2026101\",\n      \"branch\": \"Computer Science\",\n      \"year\": 3,\n      \"createdAt\": \"2026-11-12T18:00:00.000Z\",\n      \"updatedAt\": \"2026-11-12T18:00:00.000Z\",\n      \"__v\": 0\n    }\n  ]\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const resData = pm.response.json();",
                  "pm.test('Returns students array and count', function () {",
                  "    pm.expect(resData.success).to.be.true;",
                  "    pm.expect(resData.students).to.be.an('array');",
                  "    pm.expect(resData.count).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get Student By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}"]
            },
            "description": "Retrieves a specific student record using the studentId variable."
          },
          "response": [
            {
              "name": "200 OK Example",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"student\": {\n    \"_id\": \"65f1a2b3c4d5e6f7a8b9c0d1\",\n    \"studentName\": \"Aarav Sharma\",\n    \"email\": \"aarav.sharma@college.edu\",\n    \"rollNumber\": \"CS2026101\",\n    \"branch\": \"Computer Science\",\n    \"year\": 3,\n    \"createdAt\": \"2026-11-12T18:00:00.000Z\",\n    \"updatedAt\": \"2026-11-12T18:00:00.000Z\",\n    \"__v\": 0\n  }\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const resData = pm.response.json();",
                  "pm.test('Returns student object with matching ID', function () {",
                  "    pm.expect(resData.success).to.be.true;",
                  "    pm.expect(resData.student).to.be.an('object');",
                  "    pm.expect(resData.student._id).to.eql(pm.collectionVariables.get('studentId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
